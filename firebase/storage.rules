rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Past-paper scans: readable by everyone, uploaded by Skyline staff only.
    match /papers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Question diagrams and solution images.
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
