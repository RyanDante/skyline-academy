# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (never put secrets here).

# Run the whole app on bundled sample data, with no Firebase calls (phone OTP code: 123456).
EXPO_PUBLIC_USE_MOCKS=true

# Region the Cloud Functions are deployed to (must match firebase/functions/src/config.ts).
EXPO_PUBLIC_FUNCTIONS_REGION=europe-west1

# Skyline advisor WhatsApp number in international format, digits only.
EXPO_PUBLIC_SKYLINE_WHATSAPP=2376XXXXXXXX

# First paper date of the GCE session the app counts down to (confirm with the GCE Board timetable).
EXPO_PUBLIC_GCE_EXAM_START=2027-05-10

# Paths to Firebase native config files (downloaded from the Firebase console).
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist

EAS_PROJECT_ID=
